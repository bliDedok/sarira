  completedDays     Int
  elapsedDays       Int
  configVersion     String
  validationStatus  String
  calculatedAt      DateTime                @default(now()) @db.Timestamptz(3)
  createdAt         DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @db.Timestamptz(3)
  baselineSession   BaselineSession         @relation(fields: [baselineSessionId], references: [id], onDelete: Cascade)

  @@unique([baselineSessionId, scopeKey])
  @@index([baselineSessionId, scope, calculatedAt])
}

