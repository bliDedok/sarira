  sleepStartedAt    DateTime        @db.Timestamptz(3)
  wokeUpAt          DateTime        @db.Timestamptz(3)
  durationMinutes   Int
  perceivedQuality  SleepQuality
  nightAwakenings   Int?
  notes             String?
  source            TrackingSource  @default(MANUAL)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)
  profile           Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  baselineSession   BaselineSession @relation(fields: [baselineSessionId], references: [id], onDelete: Cascade)
  dailyRecord       DailyRecord     @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)

  @@index([profileId, localDate])
  @@index([baselineSessionId, localDate])
}

