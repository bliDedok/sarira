model DailyTaskDefinition {
  id                       String              @id @default(uuid()) @db.Uuid
  code                     String
  version                  String
  title                    String
  domain                   String
  minimumRequirement       Int                 @default(1)
  sortOrder                Int
  contentStatus            ContentStatus       @default(DEVELOPMENT_REQUIRES_EXPERT_VALIDATION)
  expertValidationRequired Boolean             @default(true)
  active                   Boolean             @default(true)
  createdAt                DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime            @updatedAt @db.Timestamptz(3)
  instances                DailyTaskInstance[]

  @@unique([code, version])
  @@index([active, sortOrder])
}

model DailyTaskInstance {
  id            String              @id @default(uuid()) @db.Uuid
  dailyRecordId String              @db.Uuid
  definitionId  String              @db.Uuid
  status        DailyTaskStatus     @default(PENDING)
  progress      Int                 @default(0)
  target        Int                 @default(1)
  source        DailyTaskSource     @default(SYSTEM)
  completedAt   DateTime?           @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)
  dailyRecord   DailyRecord         @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)
  definition    DailyTaskDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@unique([dailyRecordId, definitionId])
  @@index([status, updatedAt])
}

model DataCompletenessSnapshot {
  id                String                  @id @default(uuid()) @db.Uuid
  baselineSessionId String                  @db.Uuid
  scope             CompletenessScope
