# Shared server values. Copy to .env for local API/Prisma only; never commit populated files.
APP_ENV=development
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=debug
USE_MOCK_DATA=true
DATABASE_URL=postgresql://sarira:sarira_dev_only@localhost:54322/sarira?schema=public
DIRECT_URL=postgresql://sarira:sarira_dev_only@localhost:54322/sarira?schema=public
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-public-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-only-in-secure-server-environment
CORS_ORIGINS=http://localhost:8081,http://localhost:3001
RATE_LIMIT_MAX=100

# Expo public client values. These are embedded in the app bundle and must never contain server secrets.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-or-publishable-key
EXPO_PUBLIC_USE_MOCK_DATA=true

# Next.js public client values.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-or-publishable-key
