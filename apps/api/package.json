    "@prisma/client": "7.9.1",
    "@sarira/config": "workspace:*",
    "@sarira/expert-system": "workspace:*",
    "@sarira/logger": "workspace:*",
    "@sarira/shared-types": "workspace:*",
    "@sarira/validation": "workspace:*",
    "@supabase/supabase-js": "2.112.2",
    "fastify": "5.11.2",
    "fastify-plugin": "^5.1.0",
    "pg": "^8.16.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.5",
    "eslint": "^9.39.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.4",
    "vitest": "4.1.10"
  }
