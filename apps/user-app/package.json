{
  "name": "@sarira/user-app",
  "version": "0.7.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "export:web": "expo export --platform web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "clean": "rimraf dist .expo"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~57.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@sarira/api-client": "workspace:*",
    "@sarira/config": "workspace:*",
    "@sarira/design-tokens": "workspace:*",
    "@sarira/shared-types": "workspace:*",
    "@sarira/ui": "workspace:*",
    "@sarira/validation": "workspace:*",
    "@supabase/supabase-js": "2.112.2",
    "expo": "~57.0.11",
    "expo-constants": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-linking": "~57.0.0",
    "expo-router": "~57.0.11",
    "expo-splash-screen": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "lucide-react-native": "^1.28.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.0",
    "react-test-renderer": "19.2.3",
    "rimraf": "^6.0.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": ["babel-preset-expo"]
        }
      ]
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^react-native$": "<rootDir>/jest.react-native-module.cjs",
      "^react-native-svg$": "<rootDir>/jest.svg-module.cjs",
      "^lucide-react-native$": "<rootDir>/jest.lucide-module.cjs"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|expo-router|@sarira/.*|react-native-svg|lucide-react-native)/)"
    ]
  }
}
